#!/bin/sh /etc/rc.common
# llm-gateway under procd.
#
# Three things this script does that the daemon does not do for itself. Two change other packages'
# configuration: a firewall rule opening the port from each zone the gateway names (lan accepts
# input already; a zone such as iot does not), and a dnsmasq name for the gateway. Both live in
# sections named llm_gateway*, which the removal script deletes. The third is `llm-gateway prepare`,
# the root work the daemon must not need: certificates, the snapshot of where it listens, the
# backends' keys. Everything here runs on start_service, which procd's respawn does not repeat.
# The daemon then runs as its own user, in a jail, with no capability, and installs its own seccomp
# filter: procd applies a profile through LD_PRELOAD, which a static binary never loads.

USE_PROCD=1
START=96
STOP=10
PROG=/usr/bin/llm-gateway
EXTRA_COMMANDS="account"
EXTRA_HELP="	account	Make the llm-gateway user and group if they are not there"

# The group and user the snapshot's directory and the daemon's key belong to. OpenWrt's own helpers
# write the entries the way every other package's are: the next free group id, the same id for the
# user when that is free, a locked password and no login shell. The package's scripts run this too;
# it is here as well because /etc/passwd can come back from a backup without it. Removal leaves it,
# as hermes-agent's does: a later user handed the same id would own what this one left.
llmgw_account() {
	local gid uid
	gid=$(group_add_next llm-gateway)
	[ -n "$gid" ] || return 1
	user_exists llm-gateway && return 0
	uid=$gid
	cut -d: -f3 /etc/passwd | grep -qx "$uid" && uid=""
	user_add llm-gateway "$uid" "$gid" "llm-gateway" /var/empty /bin/false
	user_exists llm-gateway
}

account() {
	llmgw_account
}

sync_firewall() {
	local port zones zone changed=0 have
	config_get port main port 8760
	config_get zones main zone
	for have in $(uci -q show firewall | sed -n "s/^firewall\.\(llm_gateway_[a-z0-9_]*\)=rule$/\1/p"); do
		zone=${have#llm_gateway_}
		case " $zones " in *" $zone "*) ;; *) uci -q delete "firewall.$have"; changed=1 ;; esac
	done
	for zone in $zones; do
		if [ "$(uci -q get firewall.llm_gateway_$zone.dest_port)" != "$port" ]; then
			uci -q batch <<-EOT
				set firewall.llm_gateway_$zone='rule'
				set firewall.llm_gateway_$zone.name='Allow-llm-gateway-$zone'
				set firewall.llm_gateway_$zone.src='$zone'
				set firewall.llm_gateway_$zone.proto='tcp'
				set firewall.llm_gateway_$zone.dest_port='$port'
				set firewall.llm_gateway_$zone.target='ACCEPT'
			EOT
			changed=1
		fi
	done
	[ "$changed" = 1 ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
	return 0
}

sync_dns() {
	local name ip
	config_get name main name llm
	# The first IPv4 address the gateway listens on, from the zones it names: the same answer
	# serve computes, so the name never points at an address the gateway does not serve.
	ip=$("$PROG" addresses 2>/dev/null | sed -n 's/^\([0-9.]*\):[0-9]*$/\1/p' | grep -v '^127\.' | head -n 1)
	[ -n "$ip" ] || return 0
	if [ "$(uci -q get dhcp.llm_gateway.name)" != "$name" ] || [ "$(uci -q get dhcp.llm_gateway.ip)" != "$ip" ]; then
		uci -q batch <<-EOT
			set dhcp.llm_gateway='domain'
			set dhcp.llm_gateway.name='$name'
			set dhcp.llm_gateway.ip='$ip'
			commit dhcp
		EOT
		/etc/init.d/dnsmasq reload >/dev/null 2>&1
	fi
	return 0
}

start_service() {
	local enabled out rc cert_dir
	config_load llm-gateway
	config_get_bool enabled main enabled 0
	config_get cert_dir main cert_dir /etc/llm-gateway
	if [ "$enabled" != 1 ]; then
		logger -t llm-gateway "disabled; set llm-gateway.main.enabled=1"
		return 0
	fi
	llmgw_account || { logger -t llm-gateway "the llm-gateway account could not be made; not starting"; return 1; }
	# Before the firewall and dnsmasq: a configuration prepare refuses opens no port. What it says
	# goes to the system log, since nothing else reads its output; a refusal is one line.
	out=$("$PROG" prepare 2>&1)
	rc=$?
	[ -z "$out" ] || echo "$out" | sed 's/^llm-gateway: //' | logger -t llm-gateway
	[ "$rc" = 0 ] || return 1
	sync_firewall
	sync_dns
	procd_open_instance
	procd_set_param command "$PROG" serve
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/llm-gateway
	# procd drops this silently when the account does not exist and starts the daemon as root; the
	# account was made above, and the daemon refuses root itself.
	procd_set_param user llm-gateway
	procd_set_param group llm-gateway
	procd_set_param no_new_privs 1
	# All five sets are named and empty: procd 2026.03.13 (58eb263d) reads a set that is absent as
	# every capability, and with no file at all leaves the bounding set full.
	procd_set_param capabilities /etc/capabilities/llm-gateway.json
	# requirejail: no ujail on this router means no start, not a daemon out of the jail. No sysfs:
	# nothing here reads it. procfs is for the daemon's look at its own filter. ronly leaves only
	# the journal's directory writable.
	procd_add_jail llm-gateway log procfs ronly requirejail
	procd_add_jail_mount_rw /var/run/llm-gateway/journal
	# Only what serve reads. Never ca.key or the directory that holds it, and never the
	# firewall's, dnsmasq's or the network's configuration.
	procd_add_jail_mount /etc/config/llm-gateway "$cert_dir/tls.crt" "$cert_dir/tls.key"
	# The directory itself and not its two files: ujail makes the parents of a mounted file 0755, and
	# the daemon refuses a snapshot in a directory open to more than root and its group.
	procd_add_jail_mount /var/run/llm-gateway
	# Names of backends, and an https backend's CA. /etc/resolv.conf links to /tmp/resolv.conf, which
	# dnsmasq's start may point at the file in /tmp/resolv.conf.d.
	procd_add_jail_mount /etc/hosts /etc/ssl/certs /etc/resolv.conf /tmp/resolv.conf /tmp/resolv.conf.d
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger llm-gateway
	procd_add_interface_trigger "interface.*.up" lan /etc/init.d/llm-gateway restart
}

reload_service() {
	restart
}
